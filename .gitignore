# Local Python environments
.venv/
venv/
env/

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage

# Notebook and editor state
.ipynb_checkpoints/
.jupyter/
.DS_Store

# Large/local datasets are recreated from the documented source workbook.
data/raw/*
!data/raw/.gitkeep
data/extracted/*
!data/extracted/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Keep the final team-profiling artifacts used by the static deployment.
models/*
!models/.gitkeep
!models/team_profiling/
!models/team_profiling/final_features.json
!models/team_profiling/profile_names.json
!models/team_profiling/team_profile_kmeans.joblib
!models/team_profiling/team_profile_scaler.joblib
